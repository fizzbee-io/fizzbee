# Docker-image override of release/fizz.env (sourced by the fizz wrapper).
#
# The image runs the python parts of fizzbee on the Debian base image's
# python3 instead of the release tarball's bundled hermetic interpreter,
# so these point at the launchers in docker/ rather than at the bazel
# bootstrap scripts. See Dockerfile for why.
PARSER_BIN="${SCRIPT_DIR}/parser-launcher"
FIZZBEE_BIN="${SCRIPT_DIR}/fizzbee"
MBT_GEN_ZIP="${SCRIPT_DIR}/mbt_gen_launcher.py"
