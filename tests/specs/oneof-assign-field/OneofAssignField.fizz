---
deadlock_detection: false
---
# Regression: `TARGET = oneof COLLECTION` where TARGET is not a plain name
# (a role field, a dict entry, a list element) must assign the chosen value
# to that target, exactly like `v = oneof ...; TARGET = v`. It used to bind a
# local variable literally named "self.x" and leave the field untouched.

role R:
    action Init:
        self.x = None
        self.z = None
        self.d = {"k": None}

    atomic action PickField:
        require self.x == None
        self.x = oneof ["a", "b"]

    # The condition sees the candidate through the target, as with a plain name.
    atomic action PickFieldIf:
        require self.z == None
        self.z = oneof [1, 2, 3] if self.z != 2

    action PickDictEntry:
        require self.d["k"] == None
        self.d["k"] = oneof [10, 20]

action Init:
    r = R()
    arr = [0, 0]
    top = {"v": None}

atomic action PickTopLevelRoleField:
    require r.x == None
    r.x = oneof ["a", "b"]

atomic action PickListElement:
    require arr[1] == 0
    arr[1] = oneof [5, 6]

atomic action PickNested:
    require top["v"] == None
    top["v"] = oneof ["p", "q"]

always assertion FieldsHoldChosenValues:
    return (r.x in [None, "a", "b"]
            and r.z in [None, 1, 3]
            and r.d["k"] in [None, 10, 20]
            and arr[0] == 0 and arr[1] in [0, 5, 6]
            and top["v"] in [None, "p", "q"])

# Every choice is reachable: each field ends up set to every allowed value.
exists assertion XIsA:
    return r.x == "a"

exists assertion XIsB:
    return r.x == "b"

exists assertion ZIsThree:
    return r.z == 3

exists assertion DictIs20:
    return r.d["k"] == 20

exists assertion ArrIs6:
    return arr[1] == 6

exists assertion TopIsQ:
    return top["v"] == "q"
