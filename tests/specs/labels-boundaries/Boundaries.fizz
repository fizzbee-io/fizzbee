---
deadlock_detection: false
options:
  crash_on_yield: false
  max_concurrent_actions: 1
---
# The boundary table for threads.inside, written out by hand. Each action
# records the last step it ran in a marker variable, and the Expected
# assertion states, for every marker, which regions a thread must be in.
# Unlike the shadow-counter specs, nothing here is computed: each row is the
# intended answer at that boundary.

import threads

action Init:
    # Each *_step is the last step its action ran.
    walk_step = "idle"
    call_step = "idle"   # Call and its callee Callee
    ret_step = "idle"
    brk_step = "idle"
    nest_step = "idle"
    walk_current_inside = "unset"  # threads.current() seen from inside Walk.txn

serial action Walk:
    atomic:
        walk_step = "A"
    txn:
        atomic:
            walk_step = "B"
            walk_current_inside = threads.current().inside("Walk.txn")
        atomic:
            walk_step = "C"
    atomic:
        walk_step = "D"
        walk_current_inside = threads.current().inside("Walk.txn")

serial func Callee():
    callee_body:
        atomic:
            call_step = "callee1"
        atomic:
            call_step = "callee2"

serial action Call:
    call_site:
        atomic:
            call_step = "caller1"
        Callee()
    atomic:
        call_step = "after"

serial func RetF():
    ret_body:
        atomic:
            ret_step = "r1"
            return 1
        atomic:
            ret_step = "unreachable"

serial action Ret:
    x = RetF()
    atomic:
        ret_step = "after"

serial action Brk:
    for i in range(2):
        loop_body:
            atomic:
                brk_step = "b1"
                break
    atomic:
        brk_step = "after"

serial action Nest:
    outer:
        atomic:
            nest_step = "o1"
        inner:
            atomic:
                nest_step = "i1"
            atomic:
                nest_step = "i2"
        atomic:
            nest_step = "o2"
    atomic:
        nest_step = "after"

always assertion Expected:
    # marker: (inside the label, inside the action)
    walk = {"idle": (False, False), "A": (False, True), "B": (True, True),
            "C": (False, True), "D": (False, False)}
    if (threads.inside("Walk.txn"), threads.inside("Walk")) != walk[walk_step]:
        return False
    # current() sees its own thread: inside txn at B, out of it at D
    if walk_step == "B" and walk_current_inside != True:
        return False
    if walk_step == "D" and walk_current_inside != False:
        return False

    # (caller label, callee label, callee func, caller action). At callee2
    # the callee has run its last step but has not returned yet, so the
    # caller is still inside call_site, at the call.
    call = {"idle": (False, False, False, False),
            "caller1": (True, False, False, True),
            "callee1": (True, True, True, True),
            "callee2": (True, False, False, True),
            "after": (False, False, False, False)}
    got = (threads.inside("Call.call_site"), threads.inside("Callee.callee_body"),
           threads.inside("Callee"), threads.inside("Call"))
    if got != call[call_step]:
        return False

    # return from inside the label leaves it and the func
    ret = {"idle": (False, False, False), "r1": (False, False, True),
           "after": (False, False, False)}
    if (threads.inside("RetF.ret_body"), threads.inside("RetF"), threads.inside("Ret")) != ret[ret_step]:
        return False

    # break from inside the label leaves it, and the loop
    brk = {"idle": (False, False), "b1": (False, True), "after": (False, False)}
    if (threads.inside("Brk.loop_body"), threads.inside("Brk")) != brk[brk_step]:
        return False

    # nested labels; both at once, through one thread handle
    nest = {"idle": (False, False), "o1": (True, False), "i1": (True, True),
            "i2": (True, False), "o2": (False, False), "after": (False, False)}
    if (threads.inside("Nest.outer"), threads.inside("Nest.inner")) != nest[nest_step]:
        return False
    both = len([t for t in threads.all() if t.inside("Nest.outer") and t.inside("Nest.inner")])
    if both != (1 if nest[nest_step] == (True, True) else 0):
        return False
    return True

# Every interesting row above is reached.
exists assertion ReachMiddle:
    return walk_step == "C"

exists assertion ReachCallee:
    return call_step == "callee1"

exists assertion ReachCalleeEnd:
    return call_step == "callee2"

exists assertion ReachReturn:
    return ret_step == "r1"

exists assertion ReachBreak:
    return brk_step == "b1"

exists assertion ReachInner:
    return nest_step == "i1"

exists assertion ReachInnerEnd:
    return nest_step == "i2"
