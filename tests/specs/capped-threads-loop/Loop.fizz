---
deadlock_detection: false
options:
  crash_on_yield: false
  max_concurrent_actions: 10
action_options:
  Worker:
    max_concurrent_actions: -1
---
# Workers loop forever, so copies keep returning to the group they came
# from and merging with it. Same reachable states as an exact limit of 3.

action Init:
    x = 0
    y = 0

fair action Worker:
    while True:
        atomic:
            x = (x + 1) % 3
        y = (y + x) % 2

always eventually assertion Zero:
    return x == 0
