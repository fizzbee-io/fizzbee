digraph G {
  node [shape=box];
  splines=false;
  rankdir=LR;
  "Node" [shape=none label=<<table cellpadding="14" cellspacing="8" style="dashed">
      <tr><td port="p0">Node#0</td></tr>
      <tr><td port="p1" border="0">&#x022EE;</td></tr>
      <tr><td port="p2">Node#2</td></tr>
      </table>>]
  "actionNodeAdmin" [label="" shape="none"]
  "actionNodeAdmin" -> "Node" [label="Admin"];
  "actionNodeWork" [label="" shape="none"]
  "actionNodeWork" -> "Node" [label="Work"];
}
