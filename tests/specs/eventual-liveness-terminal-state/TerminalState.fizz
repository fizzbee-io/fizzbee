---
deadlock_detection: false
liveness: eventual
---

# Regression: with liveness: eventual, checking an eventually always
# assertion panicked on a state with no enabled action. x == 2 is such a
# state here, and the assertion holds in it.

action Init:
    x = 0

fair action Inc:
    require x < 2
    x = x + 1

eventually always assertion Done:
    return x == 2
