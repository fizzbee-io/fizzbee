---
options:
  crash_on_yield: false
deadlock_detection: false
---

action Init:
    x = 0
    ok = True
    n = 0

# The ok = True branch skips setting x, so a completed Step violates the
# assertion. The else keeps that branch enabled.
atomic action Step:
    require n < 1
    n += 1
    ok = oneof [False, True]
    if not ok:
        x = 2
    else:
        pass

transition assertion AfterOkMeansTwo(before, after):
    if after.n == before.n:
        return True
    if not after.ok:
        return True
    return after.x == 2
