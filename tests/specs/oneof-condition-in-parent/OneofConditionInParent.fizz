---
deadlock_detection: false
---
# Regression: `TARGET = oneof S if C` must give the same choices whether the
# checker filters the candidates before forking (a name target, or a field
# target whose condition only reads the candidate through the target) or
# after the assignment in each fork (a field target whose condition reads
# the target's base object some other way, like self.y != self.z).

role Node:
    action Init:
        self.y = None
        self.z = 1
        self.w = None
        self.d = {"k": None}
        self.never = None

    # Field target, condition reads the base object: evaluated in the fork.
    atomic action PickFieldFallback:
        require self.y == None
        self.y = oneof [1, 2, 3] if self.y != self.z

    # Subscript target, condition reads the whole dict: evaluated in the fork,
    # after the assignment has added the key, so len(self.d) is 2.
    atomic action PickDictFallback:
        require "n" not in self.d
        self.d["n"] = oneof [1, 2, 3] if len(self.d) == 2 and self.d["n"] != 2

    # Field target in a serial action, so the next statement is a yield point
    # away. The condition is rewritten and filtered before forking.
    action PickFieldSerial:
        require self.w == None
        self.w = oneof [1, 2, 3] if self.w != 1
        self.w = self.w * 10

    # No candidate passes: the action is disabled.
    atomic action PickNothing:
        self.never = oneof [1, 2] if self.never > 5

role Other:
    action Init:
        self.v = 0

action Init:
    n = Node()
    other = Other()
    nodes = [n, other]
    x = 0
    log = []
    peer = None

# Name target holding a role, compared with another role.
atomic action PickPeerByName:
    require peer == None
    p = oneof nodes if p != n
    peer = p

# Top-level state variable as a name target: the condition sees the candidate.
atomic action PickStateVar:
    require x == 0
    x = oneof [1, 2, 3] if x != 2

# Local name target.
atomic action PickLocal:
    require len(log) == 0
    v = oneof [1, 2, 3, 4] if v % 2 == 0 and v != x
    log.append(v)

always assertion ChoicesRespectConditions:
    return (x in [0, 1, 3]
            and n.y in [None, 2, 3]
            and n.d.get("n") in [None, 1, 3]
            and n.w in [None, 2, 3, 20, 30]
            and (peer == None or peer == other)
            and n.never == None
            and all([v in [2, 4] for v in log]))

exists assertion StateVarIs3:
    return x == 3

exists assertion FieldFallbackIs3:
    return n.y == 3

exists assertion DictFallbackIs3:
    return n.d.get("n") == 3

exists assertion SerialIs30:
    return n.w == 30

exists assertion LocalIs4:
    return len(log) == 1 and log[0] == 4

exists assertion PeerIsOther:
    return peer == other
