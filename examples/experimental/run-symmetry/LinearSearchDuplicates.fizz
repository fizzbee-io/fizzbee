---
deadlock_detection: false
---
# Linear search over a sorted (non-decreasing) array of ANY length.
# Duplicates are allowed.
#
# The unsearched suffix is a Run: record(lo, hi, many), or None when empty.
# With duplicates, lo == hi no longer means one element, so the run keeps
# one bit of abstract length:
#   many == False -> 1 element (lo == hi)
#   many == True  -> 2 or more (lo <= hi)
# Dropping the head picks the next head anywhere in [head, hi], and whether
# one or more elements remain. Strong fairness on the "more" choice says the
# array is finite.

VALS = symmetry.ordinal(name="v", limit=4)

atomic func any_run():
    size = oneof ["empty", "one", "many"]
    if size == "empty":
        return None
    low_range = oneof VALS.segments(include_points=True)
    lo = low_range.value()
    if size == "one":
        return record(lo=lo, hi=lo, many=False)
    high_range = oneof VALS.segments(include_points=True, ge=lo)
    return record(lo=lo, hi=high_range.value(), many=True)

atomic func drop_head(r):
    if not r.many:
        return None
    many = fair<strong> oneof [True, False]
    if not many:
        return record(lo=r.hi, hi=r.hi, many=False)
    next_head_range = oneof VALS.segments(include_points=True, ge=r.lo, le=r.hi)
    return record(lo=next_head_range.value(), hi=r.hi, many=True)

atomic action Init:
    target = VALS.fresh()
    run = any_run()
    result = None

atomic fair action Step:
    require result == None
    if run == None:
        result = "NOT_FOUND"
    elif run.lo == target:
        result = "FOUND"        # run.lo is the match
    elif run.lo > target:
        result = "NOT_FOUND"    # sorted: everything left is > target
    else:
        run = drop_head(run)

always assertion FoundIsCorrect:
    return result != "FOUND" or (run != None and run.lo == target)

always assertion NotFoundIsCorrect:
    # No element still unsearched can be target.
    return result != "NOT_FOUND" or run == None or target < run.lo

transition assertion OnlyDropsSmallerHeads(before, after):
    # A step that continues the search must have dropped a head below target,
    # so every dropped element is != target.
    if before.result != None or before.run == None or before.run.lo < before.target:
        return True
    return after.result != None

eventually always assertion Terminates:
    return result != None
