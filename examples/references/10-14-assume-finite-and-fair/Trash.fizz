# Example: Assuming Fairness for One Assertion
# Delete and Restore are ordinary user actions: neither is a fault, and
# neither is fair. TrashEmpty only holds if the user eventually stops
# deleting and keeps restoring, so it assumes exactly that, for this
# assertion only.
# Demonstrates: @assume(finite=[...], weak_fair=[...])

action Init:
    trash = 0

atomic action Delete:
    if trash < 2:
        trash += 1

atomic action Restore:
    if trash > 0:
        trash -= 1

@assume(finite=["Delete"], weak_fair=["Restore"])
eventually always assertion TrashEmpty:
    return trash == 0
