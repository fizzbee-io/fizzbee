# Example 0057: Error Handling Pattern
# Model errors and recovery explicitly
# Demonstrates: oneof for success/failure, error states

ErrorCode = enum('OK', 'TIMEOUT', 'INVALID')

action Init:
    state = "idle"
    error = None
    retry_count = 0

action ProcessRequest:
    require state == "idle"

    state = "processing"

    # Nondeterministically succeed or fail. Each outcome is its own block:
    # oneof picks one child statement, and blank lines or comments do not
    # group statements, so without the blocks this would be a 6-way choice.
    oneof:
        atomic:  # Success path
            state = "completed"
            error = ErrorCode.OK
        atomic:  # Timeout path
            state = "error"
            error = ErrorCode.TIMEOUT
        atomic:  # Invalid input path
            state = "error"
            error = ErrorCode.INVALID

action Retry:
    require state == "error"

    if retry_count >= 2:
        state = "failed"
        return

    retry_count = retry_count + 1
    state = "idle"
    error = None

# Verify error handling invariant
always assertion NoInfiniteRetries:
    return retry_count <= 2

atomic action NoOp:
    pass
