# Example 0101: Exists Assertion in No Graph Mode (Satisfiable)
# A satisfiable exists assertion passes under --experimental_no_graph by detecting a witness
# Demonstrates: exists assertion, --experimental_no_graph, witness detection

---
deadlock_detection: false
options:
    max_actions: 6
    crash_on_yield: false
---

# Companion to 09-10: a satisfiable `exists` must PASS under
# --experimental_no_graph (flags.txt) — the witness accumulator must
# actually detect witnesses, not just fail everything.

action Init:
    counter = 0

atomic action Inc:
    require counter < 3
    counter = counter + 1

exists assertion ReachableProbe:
    return counter == 2
