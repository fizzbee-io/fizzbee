# Example 0090: Function Called from a Serial Action
# A top level function called from a serial action yields between statements and interleaves with other actions
# Demonstrates: functions, serial actions, yield points, interleaving

# Top-level (non-role) functions can be called from serial actions.
# The function body yields between statements like any serial code,
# so other actions (and crashes) interleave with it.

MAX = 2

action Init:
    counter = 0
    last = 0

func Incr(amount):
    counter = counter + amount
    return counter

atomic action Reset:
    counter = 0
    last = 0

serial action Add:
    require counter < MAX
    last = Incr(1)
