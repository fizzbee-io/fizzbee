---
options:
  crash_on_yield: false
---
# Example: Fault Action on a Symmetric Role
# A fair<fault> role action happens only finitely often across all
# instances of the role together.
# Demonstrates: fair<fault> on a role action with symmetry reduction

symmetric role Node:
    action Init:
        self.up = True

    atomic fair<fault> action Break:
        self.up = False

    atomic fair action Repair:
        if not self.up:
            self.up = True

action Init:
    nodes = []
    for i in range(2):
        nodes.append(Node())

eventually always assertion AllUp:
    return all([n.up for n in nodes])
