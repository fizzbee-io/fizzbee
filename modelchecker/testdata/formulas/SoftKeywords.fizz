---
deadlock_detection: false
---
# The words until, unless, leadsto and implies are operators only inside a
# formula, so they can still name constants, funcs, fields and locals (see
# formula_test.go).

until = 1
P = record(leadsto=2, implies=3, unless=4)

func implies(a, b):
    return a

func leadsto(a):
    return a + until

action Init:
    x = implies(True, False)
    y = leadsto(1)
    y = y + P.leadsto + P.implies

atomic action Step:
    implies(1, 2)
    w = leadsto(until)
    unless = w
    z = [until, unless]

always assertion PassUsesNames:
    return implies(True, False) and leadsto(1) == 2 and P.implies == 3 and P.unless == 4 and until == 1

always assertion PassUsesNamesInBlock:
    v = leadsto(until)
    return v == 2 and implies(x, until)

assertion PassFormulaWithNames:
    return (implies(True, False) and P.leadsto == 2) implies eventually leadsto(until) == 2

assertion PassUnlessWithNames:
    return P.unless == 4 unless leadsto(until) == 3
