# At the parser's limit: 61 distinct conditions, two of them repeated, and
# three uses of possibly, one nested, which is 64 atoms. The checker must
# allocate the same 64 bits. TestFormulaAtomLimitMatchesParser reads the
# parsed file without checking the formula.

init:
    x = 100

atomic action Down:
    require x > 98
    x = x - 1

assertion AtLimit:
    return ((always x != 0) and (always x != 1)
        and (always x != 0)
        and (always x != 1)
        and (always x != 2)
        and (always x != 3)
        and (always x != 4)
        and (always x != 5)
        and (always x != 6)
        and (always x != 7)
        and (always x != 8)
        and (always x != 9)
        and (always x != 10)
        and (always x != 11)
        and (always x != 12)
        and (always x != 13)
        and (always x != 14)
        and (always x != 15)
        and (always x != 16)
        and (always x != 17)
        and (always x != 18)
        and (always x != 19)
        and (always x != 20)
        and (always x != 21)
        and (always x != 22)
        and (always x != 23)
        and (always x != 24)
        and (always x != 25)
        and (always x != 26)
        and (always x != 27)
        and (always x != 28)
        and (always x != 29)
        and (always x != 30)
        and (always x != 31)
        and (always x != 32)
        and (always x != 33)
        and (always x != 34)
        and (always x != 35)
        and (always x != 36)
        and (always x != 37)
        and (always x != 38)
        and (always x != 39)
        and (always x != 40)
        and (always x != 41)
        and (always x != 42)
        and (always x != 43)
        and (always x != 44)
        and (always x != 45)
        and (always x != 46)
        and (always x != 47)
        and (always x != 48)
        and (always x != 49)
        and (always x != 50)
        and (always x != 51)
        and (always x != 52)
        and (always x != 53)
        and (always x != 54)
        and (always x != 55)
        and (always x != 56)
        and (always x != 57)
        and (always x != 58)
        and (always possibly x != 0)
        and possibly (x == 99 and possibly x == 98))
