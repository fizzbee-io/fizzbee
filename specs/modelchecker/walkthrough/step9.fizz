---
deadlock_detection: false
options:
    max_concurrent_actions: 1
    crash_on_yield: false
---

# Step 9: the high-level loop, checked against every small spec instead of
# one hand-written graph. The spec under check is revealed lazily: the first
# time a state is expanded, the oracle picks its successors (known states or
# new ones) and the answer is kept, so the oracle is a function.

LIMIT = 2              # max states in a spec under check (3 also runs)
MAX_NEW = 2            # new states one expansion may introduce
MAX_ACTIONS = 2        # the checker's depth bound
DEADLOCK_DETECTION_OPTIONS = [True, False]

# State ids. Nominal: the loop only compares them for equality.
STATES = symmetry.nominal(name="state", limit=LIMIT)

# An edge is (target, is_crash). Fairness is not modeled: the loop never
# reads it. is_crash is read only by the deadlock check.

# What a correct checker must find, given the oracle's answers so far.
atomic func ground_truth(init_state, spec, kind):
    depth = {init_state: 0}
    queue = [init_state]
    bad = set()
    terminal = set()
    while len(queue) > 0:
        state = queue.pop(0)
        if kind.get(state, "ok") == "bad":
            bad.add(state)
        edges = spec.get(state, [])
        if len([e for e in edges if not e[1]]) == 0 and depth[state] < MAX_ACTIONS:
            terminal.add(state)
        if depth[state] >= MAX_ACTIONS:
            continue
        for e in edges:
            if e[0] not in depth:
                depth[e[0]] = depth[state] + 1
                queue.append(e[0])
    return {"reachable": set(depth.keys()), "bad": bad, "terminal": terminal}

role Frontier:
    action Init:
        self.visited = set()   # every state discovered so far
        self.parent = {}       # state -> state it was first reached from (for traces)
        self.queue = []        # (state, depth) not yet expanded, oldest first

    # Visit and enqueue in one step, so a state is queued at most once.
    atomic func add(state, depth, parent):
        if state in self.visited:
            return
        self.visited.add(state)
        self.parent[state] = parent
        self.queue.append((state, depth))

    atomic func pop():
        return self.queue.pop(0)

# The graph handed to the liveness check: state -> outgoing edges.
role StateGraph:
    action Init:
        self.edges = {}

    atomic func add_edge(state, edge):
        if state not in self.edges:
            self.edges[state] = set()
        self.edges[state].add(edge)

    atomic func expanded(state):
        if state not in self.edges:
            self.edges[state] = set()

# Liveness is an oracle over the finished graph.
atomic func liveness(edges):
    return "live"

role Explorer:
    action Init:
        self.current = None    # state being expanded
        self.depth = 0

    # Atomic: with one explorer nothing can interleave with an expansion.
    atomic fair action Step:
        require len(frontier.queue) > 0 and verdict == None
        entry = frontier.pop()
        state = entry[0]
        depth = entry[1]
        self.current = state
        self.depth = depth

        # Oracle: first time this state is expanded, choose its successors.
        if state not in spec:
            candidates = set()
            for i in range(MAX_NEW):
                candidates = candidates | set(STATES.choices())
            edges = set()
            for target in candidates:
                choice = oneof choices      # none, live, or crash
                if choice == "none":
                    continue
                edges.add((target, choice == "crash"))
                if target not in kind:
                    new_kind = oneof ["ok", "bad"]
                    kind[target] = new_kind
            spec[state] = list(edges)
            truth = ground_truth(init_state, spec, kind)
        successors = spec[state]

        if depth >= MAX_ACTIONS:
            successors = []
        elif deadlock_detection and len([e for e in successors if not e[1]]) == 0:
            verdict = ("DEADLOCK", state)

        for edge in successors:
            target = edge[0]
            graph.add_edge(state, edge)
            if kind[target] == "bad" and target not in frontier.visited:
                verdict = ("FAIL", target)
            frontier.add(target, depth + 1, state)

        graph.expanded(state)
        self.current = None

    atomic fair action Finish:
        require len(frontier.queue) == 0 and self.current == None and verdict == None
        result = liveness(graph.edges)
        verdict = ("LIVENESS", result)

action Init:
    deadlock_detection = oneof DEADLOCK_DETECTION_OPTIONS
    # Crash edges only matter when deadlock detection is on.
    choices = ["none", "live", "crash"] if deadlock_detection else ["none", "live"]
    spec = {}          # state -> [(target, is_crash)], as revealed so far
    kind = {}          # state -> "ok" | "bad"
    verdict = None     # None, ("FAIL", s), ("DEADLOCK", s) or ("LIVENESS", r)
    frontier = Frontier()
    graph = StateGraph()
    explorer = Explorer()

    init_state = STATES.choose()
    init_kind = oneof ["ok", "bad"]
    kind[init_state] = init_kind
    if init_kind == "bad":
        verdict = ("FAIL", init_state)
    frontier.add(init_state, 0, None)
    truth = ground_truth(init_state, spec, kind)

atomic func finished():
    return len(frontier.queue) == 0 and explorer.current == None

atomic func clean(v):
    return v == None or v[0] == "LIVENESS"

# No state outside the bound is visited.
always assertion OnlyReachableStates:
    return frontier.visited.issubset(truth["reachable"])

# A clean finish visited every reachable state.
always assertion FinishMeansComplete:
    if finished() and clean(verdict):
        return frontier.visited == truth["reachable"]
    return True

# A clean finish means there was nothing to report.
always assertion NoMissedViolation:
    if finished() and clean(verdict):
        return len(truth["bad"]) == 0 and (not deadlock_detection or len(truth["terminal"]) == 0)
    return True

# No false alarm.
always assertion ReportedFailureIsReal:
    if clean(verdict):
        return True
    if verdict[0] == "FAIL":
        return verdict[1] in truth["bad"]
    return deadlock_detection and verdict[1] in truth["terminal"]

# Liveness gets every reachable state with exactly the oracle's edges
# (states at the bound are unexpanded, so their edges are empty).
always assertion LivenessSeesWholeGraph:
    if verdict == None or verdict[0] != "LIVENESS":
        return True
    if set(graph.edges.keys()) != truth["reachable"]:
        return False
    for state in truth["reachable"]:
        if len(graph.edges[state]) > 0 and graph.edges[state] != set(spec[state]):
            return False
    return True

# Every visited state traces back to the initial state.
always assertion EveryStateHasATrace:
    for state in frontier.visited:
        cur = state
        steps = 0
        while cur != init_state and steps <= len(frontier.visited):
            cur = frontier.parent[cur]
            steps = steps + 1
        if cur != init_state:
            return False
    return True

# Every visited state is queued, being expanded, or expanded.
always assertion NoLostState:
    for state in frontier.visited:
        if state == explorer.current or state in graph.edges:
            continue
        if len([e for e in frontier.queue if e[0] == state]) > 0:
            continue
        return False
    return True

# The oracle is only asked about visited states.
always assertion OracleAskedOnce:
    for state in spec:
        if state not in frontier.visited:
            return False
    return True

# BFS: nothing queued is shallower than the state being expanded.
# Observable only from LIMIT 4 (the queue must hold two depths at once).
always assertion QueueIsBreadthFirst:
    if explorer.current == None:
        return True
    for e in frontier.queue:
        if e[1] < explorer.depth:
            return False
    return True

eventually always assertion Terminates:
    return verdict != None

exists assertion SomeRunReportsDeadlock:
    return verdict != None and verdict[0] == "DEADLOCK"

exists assertion SomeRunReachesLiveness:
    return verdict != None and verdict[0] == "LIVENESS"

exists assertion SomeRunFails:
    return verdict != None and verdict[0] == "FAIL"

exists assertion SomeSpecIsFull:
    return len(frontier.visited) == LIMIT
