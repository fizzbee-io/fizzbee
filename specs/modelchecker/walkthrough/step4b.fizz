---
deadlock_detection: false
# Baseline: today's checker. One thread, no crashes. Steps 4 and 6 turn
# these back on.
options:
    max_concurrent_actions: 1
    crash_on_yield: true
---

# Step 4b: the frontier keeps a state until its expansion is done, and a
# dead expansion is handed back. Explorer.current is in memory, so it is
# ephemeral and a crash clears it.

SPEC = {
    0: [1, 2],
    1: [3],
    2: [3],
    3: [3],
}

role Frontier:
    action Init:
        self.items = []
        self.inflight = set()

    atomic func push(s):
        self.items.append(s)

    # Hand out the oldest state but keep it until done() is called.
    atomic func claim():
        s = self.items.pop(0)
        self.inflight.add(s)
        return s

    atomic func done(s):
        self.inflight.remove(s)

    # A claim whose explorer died goes back to the queue.
    atomic func requeue(s):
        self.inflight.remove(s)
        self.items.append(s)

role Visited:
    action Init:
        self.hashes = set()

    # Check-and-set. Returns True when s was not seen before.
    atomic func add(s):
        if s in self.hashes:
            return False
        self.hashes.add(s)
        return True

role StateGraph:
    action Init:
        self.edges = {}

    atomic func edge(s, t):
        if s not in self.edges:
            self.edges[s] = []
        self.edges[s].append(t)

@state(ephemeral=["current"])
role Explorer:
    action Init:
        self.current = None

    # One turn of the loop. Serial, so every RPC is its own step and
    # another explorer could run between them.
    action Step:
        require len(frontier.items) > 0
        atomic:
            s = frontier.claim()
            self.current = s
            # The Executor: one step of the spec under check. Pure, so
            # it is not its own yield point.
            succ = SPEC[s]
        for t in succ:
            graph.edge(s, t)
            is_new = visited.add(t)
            if is_new:
                frontier.push(t)
        atomic:
            frontier.done(s)
            self.current = None

    # Nobody is working on a claimed state: its explorer crashed.
    atomic fair action Recover:
        require self.current == None and len(frontier.inflight) > 0
        s = oneof frontier.inflight
        frontier.requeue(s)

action Init:
    frontier = Frontier()
    visited = Visited()
    graph = StateGraph()
    explorer = Explorer()
    frontier.push(0)
    visited.add(0)

# The loop ends with an empty frontier and every reachable state seen.
exists assertion Finishes:
    return len(frontier.items) == 0 and explorer.current == None and len(visited.hashes) == len(SPEC)

# Every state is popped once: the graph's sources are exactly the visited set
# minus states still queued.
exists assertion GraphIsComplete:
    return len(frontier.items) == 0 and len(frontier.inflight) == 0 and set(graph.edges.keys()) == visited.hashes

# Every state we have seen is somewhere: queued, being expanded, or expanded.
always assertion NoLostState:
    for s in visited.hashes:
        if s in frontier.items or s in frontier.inflight or s in graph.edges:
            continue
        return False
    return True
